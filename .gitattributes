# Enforce LF line endings for all text files
* text=auto eol=lf

# Dart source files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Web and config files
*.html text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf

# Shell scripts
*.sh text eol=lf
*.bat text eol=crlf

# Gradle / Kotlin
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf

# Swift
*.swift text eol=lf

# Binary files (no normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary